# Скопировать в .env и заполнить. .env в гит не коммитится.

DATABASE_URL=postgresql://...

# System User token из Business Manager с правами ads_read.
# НЕ пользовательский: тот протухнет через 60 дней и уронит крон.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_AD_ACCOUNT_IDS=act_...,act_...
META_APP_SECRET=

CRM_BASE_URL=
CRM_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Дублируют config-ключ 'windows'. Значение в базе главнее — здесь только
# для скриптов, которые ходят в Meta до того, как открыли соединение с БД.
SETTLED_WINDOW_DAYS=7
RESTATEMENT_WINDOW_DAYS=14
